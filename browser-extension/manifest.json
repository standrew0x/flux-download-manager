{
  "manifest_version": 3,
  "name": "Flux Download Capture",
  "version": "1.0.1",
  "description": "Hands browser downloads larger than your threshold to Flux Download Manager.",
  "minimum_chrome_version": "120",
  "permissions": ["downloads", "storage", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Flux Download Capture", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
